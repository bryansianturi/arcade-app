<body>

    <!-- arcade: loading card, plus early downloads of everything the page will need -->
    <div id="arcade-loader">
        <div class="card">
            <h1>{{cookiecutter.title}}</h1>
            <p class="status" id="arcade-status">Downloading the game engine…</p>
            <div class="bar"><div class="fill" id="arcade-fill"></div></div>
            <div class="meta"><span id="arcade-mb">0.0 MB</span><span id="arcade-pct">0%</span></div>
            <p class="note">The first visit downloads about 11 MB. After that it loads in a second or two.</p>
        </div>
    </div>
    <script>
    (() => {
        // pygbag fetches these one after another as Python starts up. Asking for all of
        // them now downloads them in parallel; its later requests hit the browser cache.
        // XHR (not fetch) so progress counts compressed bytes against Content-Length.
        const cdn = "{{cookiecutter.cdn}}";
        const py = "cp" + "{{cookiecutter.PYBUILD}}".replace(".", "");
        const archive = location.host.includes(".itch.zone")
            ? "{{cookiecutter.archive}}.apk" : "{{cookiecutter.archive}}.tar.gz";
        // Rough compressed sizes (MB), used until each download reports its real size.
        const files = [
            [cdn + "cpython" + py.slice(2) + "/main.wasm", 4.6],
            [cdn + "cpython" + py.slice(2) + "/main.data", 4.5],
            [archive, 0.6],
            [cdn + "cpythonrc.py", 0.01],
        ];
        const loaded = new Map(), total = new Map();
        const fill = document.getElementById("arcade-fill");
        const mb = document.getElementById("arcade-mb");
        const pct = document.getElementById("arcade-pct");
        const status = document.getElementById("arcade-status");
        let starting = false;

        function render() {
            let got = 0, all = 0;
            for (const [url, guess] of files) {
                const t = total.get(url) || guess * 1e6;
                got += Math.min(loaded.get(url) || 0, t);
                all += t;
            }
            const frac = all ? got / all : 0;
            // Downloads fill 90% of the bar; Python starting up fills the rest.
            const shown = starting ? 0.95 : 0.9 * frac;
            fill.style.width = Math.max(2, shown * 100) + "%";
            pct.textContent = Math.round(shown * 100) + "%";
            mb.textContent = (got / 1e6).toFixed(1) + " / " + (all / 1e6).toFixed(1) + " MB";
            if (!starting && frac >= 0.999) {
                starting = true;
                status.textContent = "Starting Python…";
                render();
            }
        }

        function preload(url) {
            const xhr = new XMLHttpRequest();
            xhr.open("GET", url);
            xhr.responseType = "arraybuffer";
            xhr.onprogress = (e) => {
                loaded.set(url, e.loaded);
                if (e.lengthComputable) total.set(url, e.total);
                render();
            };
            xhr.onload = () => {
                const size = xhr.response ? xhr.response.byteLength : 0;
                if (!total.has(url)) total.set(url, loaded.get(url) || size);
                loaded.set(url, total.get(url));
                render();
            };
            xhr.onerror = () => { loaded.set(url, total.get(url) || 0); render(); };
            xhr.send();
        }

        files.forEach(([url]) => preload(url));
        // The pygame wheel's exact name comes from the CDN's package index.
        const root = new URL("..", cdn).href;
        fetch(root + "index-{{cookiecutter.version}}-" + py + ".json")
            .then((r) => r.json())
            .then((index) => {
                if (!index.pygame) return;
                const wheel = root + index.pygame.replace("<abi>-<abi>-<api>", py + "-" + py + "-wasm32_bi_emscripten");
                files.push([wheel, 1.5]);
                preload(wheel);
            })
            .catch(() => {});

        window.arcadeLoaded = () => {
            starting = true;
            fill.style.width = "100%";
            pct.textContent = "100%";
            document.getElementById("arcade-loader").classList.add("done");
            setTimeout(() => document.getElementById("arcade-loader").remove(), 600);
        };
        render();
    })();
    </script>

